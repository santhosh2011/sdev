# Per-task PDMT "chips" stack — generated by sdev new-task for project pdmt.
# Mirrors the monorepo's own docker-compose.local.yml, adapted to the sdev
# per-task layout: ONE worktree of edm-apps-obs-pdmt-chips-ui is mounted, and
# host ports come from .env (<SVC>_HOST_PORT = base + PORT_OFFSET).
#
# Monorepo layout inside the worktree:
#   ./edm-apps-obs-pdmt-chips-ui/backend   FastAPI + TaskIQ (was chips-api)
#   ./edm-apps-obs-pdmt-chips-ui/ui        vite SPA
#   ./edm-apps-obs-pdmt-chips-ui/common    git submodule -> edm-apps-obs-common
#
# BOOTSTRAP the common submodule once after `sdev new` (worktrees do NOT init
# submodules) — else /app/common is empty and api/ui fail:
#   git -C edm-apps-obs-pdmt-chips-ui submodule update --init
#
# Dev pattern: bind-mount backend + common and import via PYTHONPATH (no editable
# installs). The vite `ui` service serves the SPA with HMR and proxies to api; it
# publishes on ${NGINX_HOST_PORT} (the sdev "web" slot) so `sdev open` / the task
# URL keep working. Databricks creds + ARTIFACTORY_NPM_TOKEN come from
# ./app.env + ./.env.
#
# The DB is POSTGRES, not MySQL: backend/requirements.txt ships psycopg/asyncpg
# only, and app.env pins DB_DIALECT=postgresql. A mysql `db` here means the
# psycopg driver dials port 3306 and dies on "invalid response to SSL
# negotiation" before alembic can run.

x-pyenv: &pyenv
  DB_DIALECT: postgresql
  DB_HOST: db
  DB_PORT: "5432"
  DB_USER: postgres
  DB_PASSWORD: pdmt
  DB_NAME: pdmt_chips
  # app.env pins the Databricks schema (sch_edm_obs_chips), which the local postgres
  # does not have — and the pinned `common` submodule's make_async_engine() takes no
  # `schema=` kwarg yet, so a set DB_SCHEMA is a TypeError at startup. Blank it, the
  # way backend/e2e/docker-compose.e2e.yml does. `environment:` outranks `env_file:`.
  DB_SCHEMA: ""
  REDIS_URL: redis://redis:6379/0
  # PDMT_DATABRICKS_HOST / PDMT_TOKEN / PDMT_DATABRICKS_WAREHOUSE_ID deliberately
  # do NOT appear here. They come from ./app.env via env_file. Listing them as
  # `KEY: ${KEY}` interpolates to "" whenever the host shell has not exported them
  # (it never does — app.env is not sourced into the shell), and an empty
  # `environment:` value OUTRANKS env_file — so the ingest would authenticate to
  # Databricks with blank creds.
  PYTHONPATH: /app/common/src:/app/backend/src
  PYTHONUNBUFFERED: "1"
  PIP_ROOT_USER_ACTION: ignore
# The pip cache is shared by seed/api/worker/beat so only the first of the four
# pays for the requirements.txt download.
x-pymounts: &pymounts
  - ./edm-apps-obs-pdmt-chips-ui/common:/app/common
  - ./edm-apps-obs-pdmt-chips-ui/backend:/app/backend
  - pip-cache:/root/.cache/pip
services:
  db:
    image: postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: pdmt
      POSTGRES_DB: pdmt_chips
    ports:
      - "127.0.0.1:${DB_HOST_PORT}:5432"
    volumes:
      # postgres:18 stores data under a major-version subdirectory, so the mount
      # must be the parent — see backend/e2e/docker-compose.e2e.yml.
      - chips-postgres:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d pdmt_chips"]
      interval: 5s
      timeout: 5s
      retries: 20
    networks: [task-net]
  # One-shot: migrate + load the deterministic e2e fixtures (GB200/H100/STGE/...),
  # so the canvas has data without Databricks creds or VPN. api/worker/beat all wait
  # on it, so exactly one process runs alembic.
  seed:
    image: python:3.14
    working_dir: /app/backend
    env_file:
      - ./app.env
      - ./.env
    environment: *pyenv
    volumes: *pymounts
    depends_on:
      db:
        condition: service_healthy
    command:
      - bash
      - -lc
      - >
        pip install --quiet -r requirements.txt && alembic upgrade head && python e2e/seed/adapter.py --fixtures e2e/seed/fixtures.json

    networks: [task-net]
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${REDIS_HOST_PORT}:6379"
    networks: [task-net]
  api:
    image: python:3.14
    restart: unless-stopped
    working_dir: /app/backend
    env_file:
      - ./app.env
      - ./.env
    environment: *pyenv
    volumes: *pymounts
    ports:
      - "127.0.0.1:${API_HOST_PORT}:8291"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
      seed:
        condition: service_completed_successfully
    command:
      - bash
      - -lc
      - >
        pip install --quiet -r requirements.txt && uvicorn pdmt_chips_api.main:app --host 0.0.0.0 --port 8291 --reload

    networks: [task-net]
  # TaskIQ replaced Celery: the broker is a Redis Stream, the task modules must be
  # named on the command line, and the cron schedules are declared as task labels
  # (see backend/src/pdmt_chips_api/core/taskiq_app.py). Keep this argv in step with
  # backend/supervisord.conf, which runs the same two roles in the deployed image.
  worker:
    image: python:3.14
    restart: unless-stopped
    working_dir: /app/backend
    env_file:
      - ./app.env
      - ./.env
    environment: *pyenv
    volumes: *pymounts
    depends_on:
      redis:
        condition: service_started
      seed:
        condition: service_completed_successfully
    command:
      - bash
      - -lc
      - >
        pip install --quiet -r requirements.txt && taskiq worker pdmt_chips_api.core.taskiq_app:broker pdmt_chips_api.modules.bom_visualisation.tasks pdmt_chips_api.modules.chat.glossary.tasks

    networks: [task-net]
  beat:
    image: python:3.14
    restart: unless-stopped
    working_dir: /app/backend
    env_file:
      - ./app.env
      - ./.env
    environment: *pyenv
    volumes: *pymounts
    depends_on:
      redis:
        condition: service_started
      seed:
        condition: service_completed_successfully
    command:
      - bash
      - -lc
      - >
        pip install --quiet -r requirements.txt && taskiq scheduler pdmt_chips_api.core.taskiq_app:scheduler pdmt_chips_api.modules.bom_visualisation.tasks pdmt_chips_api.modules.chat.glossary.tasks

    networks: [task-net]
  # UI dev server in-container (vite) — serves the SPA and proxies /pdmt-api ->
  # api over the compose network. node_modules live in anonymous volumes because
  # the host dirs hold darwin binaries and the container needs linux ones.
  ui:
    image: node:22
    restart: unless-stopped
    working_dir: /app/ui
    env_file:
      - ./app.env
      - ./.env
    environment:
      VITE_HOST: "0.0.0.0"
      PDMT_API_PROXY: http://api:8291
      VITE_HMR_CLIENT_PORT: "${NGINX_HOST_PORT}"
      ARTIFACTORY_NPM_TOKEN: ${ARTIFACTORY_NPM_TOKEN}
    volumes:
      - ./edm-apps-obs-pdmt-chips-ui/common:/app/common
      - ./edm-apps-obs-pdmt-chips-ui/ui:/app/ui
      - /app/common/node_modules
      - /app/ui/node_modules
      - npm-cache:/root/.npm
    ports:
      - "${NGINX_HOST_PORT}:5173"
    depends_on:
      api:
        condition: service_started
    command:
      - bash
      - -lc
      - >
        cd /app/common && npm install && npm run build && cd /app/ui && npm install --no-package-lock && npm run dev

    networks: [task-net]
volumes:
  chips-postgres:
  pip-cache:
    external: true
    name: sdev-pip-cache
  npm-cache:
    external: true
    name: sdev-npm-cache
networks:
  task-net:
    driver: bridge
