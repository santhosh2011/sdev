# Per-task SCDI stack — generated by bin/new-task for project sdi.
# Migrated onto the new NVIDIA repos:
#   api  -> edm-apps-scdi-backend   (worktree dir: cognito_ai_scdi_api)
#   ui   -> edm-apps-ai-observability (vite app lives in cognitoaitesting/)
#
# api/worker/beat are BUILT per task from the backend's own cicd/Dockerfile
# (multi-stage, targets api|worker|beat). The image installs msodbcsql18 which
# is amd64-only, so we pin platform: linux/amd64 (runs under emulation on Apple
# Silicon / OrbStack). The heavy builder + base layers are shared across the
# three targets, so a single `compose build` builds them once.
#
# DB is a self-contained postgres container (develop migrated MySQL -> Postgres,
# 2026-07; creds match e2e/docker-compose.e2e.yml); alembic builds the schema on
# api startup. No seed SQL, no remote infra (local profile). Redis is the broker.
#
# Host ports come from .env (<SVC>_HOST_PORT). App config comes from ./app.env
# (symlink -> confs/cognito-ai-scdi-api.<profile>.env).

services:
  postgres:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: scdi
      POSTGRES_PASSWORD: scdipass
      POSTGRES_DB: scdi
    ports:
      - "127.0.0.1:${DB_HOST_PORT}:5432"
    volumes:
      - scdi-postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U scdi -d scdi"]
      interval: 5s
      timeout: 5s
      retries: 20
    networks: [task-net]
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${REDIS_HOST_PORT}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
    networks: [task-net]
  api:
    build:
      context: ./cognito_ai_scdi_api
      dockerfile: cicd/local.Dockerfile
      additional_contexts:
        obs_common: ./common
      target: api
    restart: unless-stopped
    env_file:
      - ./app.env
      - ./.env
    environment:
      DB_HOST: postgres
      REDIS_URL: redis://redis:6379/0
    ports:
      - "127.0.0.1:${API_HOST_PORT}:8291"
    volumes:
      # bind-mount source for hot-reload; the built image already has a copy
      - ./cognito_ai_scdi_api/src:/app/src
      - ./cognito_ai_scdi_api/configs:/app/configs
      - ./cognito_ai_scdi_api/migrations:/app/migrations
      - ./cognito_ai_scdi_api/alembic.ini:/app/alembic.ini
      # migration 0058 shells out to `manage.py import-glossary` (reads
      # scripts/data/glossary_snapshot.json) — neither is in the cicd image.
      - ./cognito_ai_scdi_api/manage.py:/app/manage.py
      - ./cognito_ai_scdi_api/scripts:/app/scripts
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
    command:
      - sh
      - -c
      - |
        if [ "$$APP_ENV" = "local" ]; then
          echo "[entrypoint] APP_ENV=local -> alembic upgrade head"
          alembic -c /app/alembic.ini upgrade head
        else
          echo "[entrypoint] APP_ENV=$$APP_ENV (non-local) -> skipping alembic migrations"
        fi
        exec uvicorn scdi_api.api.main:app --host 0.0.0.0 --port 8291 --reload
    networks: [task-net]
  worker:
    build:
      context: ./cognito_ai_scdi_api
      dockerfile: cicd/local.Dockerfile
      additional_contexts:
        obs_common: ./common
      target: worker
    restart: unless-stopped
    profiles: ["workers"]
    env_file:
      - ./app.env
      - ./.env
    environment:
      DB_HOST: postgres
      REDIS_URL: redis://redis:6379/0
    volumes:
      - ./cognito_ai_scdi_api/src:/app/src
      - ./cognito_ai_scdi_api/configs:/app/configs
      - ./cognito_ai_scdi_api/manage.py:/app/manage.py
      - ./cognito_ai_scdi_api/scripts:/app/scripts
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
    networks: [task-net]
  beat:
    build:
      context: ./cognito_ai_scdi_api
      dockerfile: cicd/local.Dockerfile
      additional_contexts:
        obs_common: ./common
      target: beat
    restart: unless-stopped
    profiles: ["workers"]
    env_file:
      - ./app.env
      - ./.env
    environment:
      DB_HOST: postgres
      REDIS_URL: redis://redis:6379/0
    volumes:
      - ./cognito_ai_scdi_api/src:/app/src
      - ./cognito_ai_scdi_api/configs:/app/configs
      - ./cognito_ai_scdi_api/manage.py:/app/manage.py
      - ./cognito_ai_scdi_api/scripts:/app/scripts
    depends_on:
      redis:
        condition: service_started
    networks: [task-net]
  ui:
    image: node:22
    restart: unless-stopped
    working_dir: /app
    env_file:
      - /Users/santhosh/code/shamrock/confs/scdi_ui.env
    ports:
      - "127.0.0.1:${UI_HOST_PORT}:5173"
    volumes:
      # develop layout: the scdi-ui vite app lives at the repo ROOT (was cognitoaitesting/)
      - ./edm-apps-ai-observability:/app
      - scdi-ui-node-modules:/app/node_modules
      - npm-cache:/root/.npm
    depends_on:
      api:
        condition: service_started
    command:
      - sh
      - -c
      - |
        set -e
        cd /app
        npm install --no-audit --no-fund
        # sdev local dev: serve plain http and repoint the api proxies at the
        # scdi api service (vite proxies server-side over task-net). The repo's
        # committed vite.config targets :8000/:8001 + https/mkcert — patched here
        # in the disposable task worktree, never in the source repo.
        sed -i \
          -e 's#http://localhost:8000#http://api:8291#g' \
          -e 's#http://localhost:8001#http://api:8291#g' \
          -e 's#https: true#https: false#g' \
          -e "s#protocol: 'wss'#protocol: 'ws'#g" \
          -e 's#mkcert()##g' \
          vite.config.js
        exec npm run dev -- --host 0.0.0.0 --port 5173
    networks: [task-net]
  # Single-origin reverse proxy (confs/nginx.conf, upstreams repointed at task-net
  # service names — see core/scdi/nginx.conf). Routes / -> ui, /scdi-api -> api.
  nginx:
    image: nginx:alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:${NGINX_HOST_PORT}:5200"
    volumes:
      - /Users/santhosh/code/shamrock/core/scdi/nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      api:
        condition: service_started
      ui:
        condition: service_started
    networks: [task-net]
volumes:
  scdi-postgres:
  scdi-ui-node-modules:
  npm-cache:
    external: true
    name: sdev-npm-cache
networks:
  task-net:
    driver: bridge
